// Ressources de l'exécutable Windows : icône (Explorateur, barre des tâches)
// et informations de version (Propriétés > Détails). Modèle : build.rs
// remplace les @…@ (version, chemin de l'icône) et compile la copie obtenue,
// uniquement pour une cible Windows. Pas de macro /D pour la version : rc.exe
// ne sait pas recevoir une chaîne entre guillemets par la ligne de commande.

1 ICON "@ICON@"

1 VERSIONINFO
FILEVERSION     @MAJOR@, @MINOR@, @PATCH@, 0
PRODUCTVERSION  @MAJOR@, @MINOR@, @PATCH@, 0
FILEOS          0x40004
FILETYPE        0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040C04B0"
    BEGIN
      VALUE "CompanyName",      "Its Async"
      VALUE "FileDescription",  "Async Herald"
      VALUE "FileVersion",      "@VERSION@"
      VALUE "InternalName",     "herald-desktop"
      VALUE "LegalCopyright",   "Its Async"
      VALUE "OriginalFilename", "herald-desktop.exe"
      VALUE "ProductName",      "Async Herald"
      VALUE "ProductVersion",   "@VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x040C, 1200
  END
END
