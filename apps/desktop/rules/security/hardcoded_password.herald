// Version Herald Desktop. Mesure de référence : 0/10 vrais positifs (booléens,
// nombres et codes d'erreur acceptés comme « constante », exemples de
// documentation). Ne relève plus qu'une vraie chaîne affectée à une variable
// dont le nom se termine par password / passwd / pwd / passphrase.
rule hardcoded_password {
  meta {
    type: security
    severity: error
    message: "Mot de passe en dur — déplace-le dans une variable d'environnement ou un gestionnaire de secrets, et change-le s'il a été publié"
  }
  dedupe line
  match {
    js, ts: const $KEY = $VAL
    js, ts: let $KEY = $VAL
    py: $KEY = $VAL
  }
  // Écartés (faux positifs mesurés) : identifiants et libellés (`"Password"`,
  // `"invalid_password"`), gabarits (`%(password)s`, `{password}`, `:pwd`),
  // valeurs de test ou d'exemple (`test123`, `example…`).
  when $KEY matches /(?i)(?:password|passwd|passphrase|pwd)$/
    and $VAL is constant
    and $VAL matches /^b?['"]/
    and len($VAL) >= 6
    and not $VAL matches /^b?['"][A-Za-z]+(?:[_\-][A-Za-z]+)*['"]$/
    and not $VAL matches /%\(|\{\w*\}|\s|\$\w|:\w+/
    and not $VAL matches /(?i)^b?['"](?:test|demo|sample|example|dummy|fake|secret|password)/
    and not placeholder($VAL)

  tests {
    js {
      "const dbPassword = 'S3cr3t!pw'" => fail
      "const password = process.env.DB_PASSWORD" => pass
      "const password = 'changeme'" => pass
      "const passwordlength = 16" => pass
      "const passwordHashKeyLength = 32" => pass
      "export const password = 'test123'" => pass
    }
    py {
      "DB_PASSWORD = 'Tr0ub4dor&3'" => fail
      "prompt_password = True" => pass
      "INVALID_PASSWORD = 'invalid_password'" => pass
      "FTP_PASSWORD = 'guest'" => pass
      "SOCKS5_METHOD_USER_PASSWORD_AUTHENTICATION = 0x02" => pass
      "set_password = 'ALTER USER %(user)s IDENTIFIED BY \"%(password)s\"'" => pass
      "PASSWORD = \"Password\"" => pass
    }
  }
}
