// Version Herald Desktop. Mesure de référence : 0/10 vrais positifs (noms
// d'en-têtes, identifiants et messages contenant « token »). Ne relève plus
// qu'une valeur qui ressemble à une clé (sans espace, lettres et chiffres,
// 16 caractères ou plus) affectée à une variable nommée comme un secret.
rule hardcoded_secret {
  meta {
    type: security
    severity: error
    message: "Secret en dur (clé API, jeton, clé de signature) — déplace-le dans une variable d'environnement ou un gestionnaire de secrets, et révoque-le s'il a été publié"
  }
  match {
    js, ts: const $KEY = $VAL
    js, ts: let $KEY = $VAL
    py:     $KEY = $VAL
  }
  when $KEY matches /(?i)(?:secret|secret[_-]?key|token|api[_-]?key|access[_-]?key|auth[_-]?token|private[_-]?key|client[_-]?secret|signing[_-]?key)$/
    and $VAL is constant
    and $VAL matches /^b?['"][A-Za-z0-9_\-+\/=.]{16,}['"]$/
    and $VAL matches /[0-9]/
    and $VAL matches /[A-Za-z]/
    and entropy($VAL) > 3.5
    and not placeholder($VAL)

  tests {
    js {
      "const apiKey = 'a8F3kZ9qLmP2xV7w'" => fail
      "const apiKey = process.env.API_KEY" => pass
      "const SHARE_TOKEN_HEADER = 'x-umami-share-token'" => pass
      "const DYNAMIC_TOKEN = 'DYNAMIC_TOKEN'" => pass
      "const TRANSFER_TOKEN_UID = 'admin::transfer-token'" => pass
      "const tokenUrl = 'https://api.example.com/v2/resource'" => pass
    }
    py {
      "SECRET_KEY = '09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7'" => fail
      "REASON_CSRF_TOKEN_MISSING = 'CSRF token missing.'" => pass
      "SUCCESSFULLY_TOKENIZED = 'successfully_tokenized'" => pass
      "INVALID_TOKEN = 'Invalid or expired token.'" => pass
    }
  }
}
