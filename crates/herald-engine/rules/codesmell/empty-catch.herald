rule empty-catch {
  meta {
    type: quality
    severity: warning
    message: "Bloc catch vide — l'erreur est avalée silencieusement ; logge-la, traite-la, ou relance-la"
  }
  use empty_catch

  tests {
    js {
      "try { risky() } catch (e) {}" => fail
      "try { risky() } catch (e) { log(e) }" => pass
    }
  }
}
