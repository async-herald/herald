rule magic-number {
  meta {
    type: code-smell
    severity: info
    message: "Nombre magique dans une comparaison — extrais-le dans une constante nommée pour expliquer sa signification"
  }
  dedupe line
  lang js, ts {
    pattern (binary_expression) @match
    where @match ~ /(?:===?|!==?|<=?|>=?)\s*\d{3,}\b|\b\d{3,}\s*(?:===?|!==?|<=?|>=?)/
  }

  tests {
    js {
      "if (status === 404) {}" => fail
      "if (count > 1000) {}" => fail
      "if (x === 0) {}" => pass
      "if (i < 10) {}" => pass
    }
  }
}
