rule no_alert {
  meta {
    type: quality
    severity: warning
    message: "Évite alert/confirm/prompt — ces dialogues bloquants nuisent à l'UX et sont souvent des oublis de debug"
  }
  dedupe linecol
  match {
    js, ts: alert($X)
    js, ts: confirm($X)
    js, ts: prompt($X)
  }

  tests {
    js {
      "alert('saved!')" => fail
      "logger.warn('saved!')" => pass
    }
  }
}
