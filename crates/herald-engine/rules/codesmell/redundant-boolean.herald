rule redundant-boolean {
  meta {
    type: quality
    severity: warning
    message: "Littéral booléen redondant — utilise la condition directement (`if (x)`, `return cond`) plutôt que de la comparer à ou renvoyer true/false"
  }
  dedupe linecol
  lang js, ts, java {
    pattern (binary_expression) @match
    where @match ~ /(?:===?|!==?)\s*(?:true|false|True|False)\b|\b(?:true|false|True|False)\s*(?:===?|!==?)|\bis(?:\s+not)?\s+(?:True|False)\b/
  }
  lang js, ts, java {
    pattern (ternary_expression) @match
    where @match ~ /\?\s*(?:true|false)\s*:\s*(?:true|false)\b|\b(?:True|False)\s+if\b[\s\S]*?\belse\s+(?:True|False)\b/
  }
  lang py {
    pattern (comparison_operator) @match
    where @match ~ /(?:===?|!==?)\s*(?:true|false|True|False)\b|\b(?:true|false|True|False)\s*(?:===?|!==?)|\bis(?:\s+not)?\s+(?:True|False)\b/
  }
  lang py {
    pattern (conditional_expression) @match
    where @match ~ /\?\s*(?:true|false)\s*:\s*(?:true|false)\b|\b(?:True|False)\s+if\b[\s\S]*?\belse\s+(?:True|False)\b/
  }
  lang go, rust {
    pattern (binary_expression) @match
    where @match ~ /(?:===?|!==?)\s*(?:true|false|True|False)\b|\b(?:true|false|True|False)\s*(?:===?|!==?)|\bis(?:\s+not)?\s+(?:True|False)\b/
  }

  tests {
    js {
      "const ok = x === true" => fail
      "const ok = x" => pass
    }
  }
}
