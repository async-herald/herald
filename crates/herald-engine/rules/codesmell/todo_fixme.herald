rule todo_fixme {
  meta {
    type: quality
    severity: warning
    message: "Marqueur TODO/FIXME laissé dans un commentaire — traite-le ou ouvre un ticket de suivi"
  }
  use todo_fixme

  tests {
    js {
      "// TODO: handle the error case" => fail
      "// returns the parsed config" => pass
    }
  }
}
