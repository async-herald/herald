rule too-many-params {
  meta {
    type: quality
    severity: warning
    message: "Trop de paramètres ({value} > {threshold}) — regroupe les arguments liés dans un objet/struct"
  }
  # php 6 : la promotion de constructeur porte les dépendances injectées.
  measure params > 5 (javascript 4, typescript 4, java 7, php 6)

  tests {
    js {
      "function f(a, b, c, d, e, g) {}" => fail
      "function f(a, b) {}" => pass
    }
  }
}
