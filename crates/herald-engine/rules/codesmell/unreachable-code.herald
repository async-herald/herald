rule unreachable-code {
  meta {
    type: quality
    severity: warning
    message: "Code mort après un return/throw/break — il ne s'exécute jamais ; supprime-le"
  }
  use unreachable_code

  tests {
    js {
      "function f() { return 1; doMore(); }" => fail
      "function f() { doMore(); return 1; }" => pass
    }
  }
}
