rule unused-parameter {
  meta {
    type: quality
    severity: warning
    message: "Paramètre de fonction jamais utilisé — supprime-le ou préfixe-le par '_'"
  }
  use unused_parameter

  tests {
    js {
      "function f(unused, a) { return a; }" => fail
      "function f(a) { return a; }" => pass
    }
  }
}
