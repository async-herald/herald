rule wildcard_import {
  meta {
    type: quality
    severity: warning
    message: "Évite 'from module import *' — pollue l'espace de noms et masque l'origine des symboles"
  }
  match {
    py: from $M import *
  }

  tests {
    py {
      "from os import *" => fail
      "from os import path" => pass
    }
  }
}
