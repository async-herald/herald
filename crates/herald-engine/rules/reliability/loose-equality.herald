rule loose-equality {
  meta {
    type: quality
    severity: warning
    message: "Égalité faible (== / !=) — effectue une coercition de type source de bugs subtils ; utilise === / !=="
  }
  dedupe line
  lang js, ts {
    pattern (binary_expression) @match
    where @match ~ /(^|[^=!<>])(==|!=)($|[^=])/
  }
  # PHP a en plus `<>`, synonyme de `!=`.
  lang php {
    pattern (binary_expression) @match
    where @match ~ /(^|[^=!<>])(==|!=|<>)($|[^=])/
  }

  tests {
    js {
      "if (a == b) {}" => fail
      "if (a != b) {}" => fail
      "if (a === b) {}" => pass
      "if (a !== b) {}" => pass
    }
    php {
      "<?php if ($a == $b) {}" => fail
      "<?php if ($a <> $b) {}" => fail
      "<?php if ($a === $b) {}" => pass
      "<?php if ($a !== $b) {}" => pass
    }
  }
}
