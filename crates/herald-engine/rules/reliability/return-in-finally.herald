rule return-in-finally {
  meta {
    type: quality
    severity: warning
    message: "return/throw/break dans un finally — écrase la valeur ou l'exception du try/catch et masque les erreurs ; sors ce flux de contrôle du finally"
  }
  dedupe line
  lang js, ts {
    pattern (finally_clause) @match
    where @match ~ /\b(?:return|throw|break|continue)\b/
  }

  tests {
    js {
      "try { f() } finally { return 1 }" => fail
      "try { f() } finally { cleanup() }" => pass
    }
  }
}
