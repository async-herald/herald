rule cors-credentialed-wildcard {
  meta {
    type: security
    severity: error
    message: "CORS dangereux : origine '*' (ou reflétée) combinée à credentials — expose cookies/identifiants à n'importe quelle origine ; quand credentials est activé, fixe une allowlist d'origines explicites"
  }
  dedupe line
  lang js, ts {
    pattern (call_expression) @match
    where @match ~ /credentials\s*:\s*true/
      and @match ~ /origin\s*:\s*(?:['"]\*['"]|true)/
  }
  lang py {
    pattern (call) @match
    where @match ~ /supports_credentials\s*=\s*True/
      and @match ~ /origins?\s*=\s*['"]\*['"]/
  }

  tests {
    js {
      "app.use(cors({ origin: '*', credentials: true }))" => fail
      "app.use(cors({ origin: 'https://a.com', credentials: true }))" => pass
    }
  }
}
