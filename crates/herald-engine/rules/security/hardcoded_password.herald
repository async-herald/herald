rule hardcoded_password {
  meta {
    type: security
    severity: error
    message: "Mot de passe en dur — déplace-le dans une variable d'environnement / un gestionnaire de secrets"
  }
  match {
    js, ts: const $KEY = $VAL
    py: $KEY = $VAL
  }
  when $KEY matches /(?i)(password|passwd|passphrase|pwd)/
    and $VAL is constant
    and not placeholder($VAL)

  tests {
    js {
      "const password = 'hunter2!'" => fail
      "const password = process.env.DB_PASSWORD" => pass
      "const password = 'changeme'" => pass
      "const userName = 'alice'" => pass
    }
    py {
      "db_passwd = 'S3cr3t!'" => fail
    }
  }
}
