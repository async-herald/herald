rule hardcoded_secret {
  meta {
    type: security
    severity: error
    message: "Hardcoded secret (API key, token, credential) — move it to an environment variable / secret store"
  }

  match {
    js, ts: const $KEY = $VAL
    py:     $KEY = $VAL
  }
  when $KEY matches /(?i)(secret|token|api[_-]?key|access[_-]?key|auth[_-]?token|credential|private[_-]?key)/
    and $VAL is constant
    and entropy($VAL) > 3.5
    and not $VAL matches /:\/\//

  tests {
    js {
      "const apiKey = 'a8F3kZ9qLmP2xV7w'"                       => fail
      "const apiKey = process.env.API_KEY"                      => pass
      "const apiKey = 'changeme'"                               => pass
      "const tokenUrl = 'https://api.example.com/v2/resource'"  => pass
      "const label = 'a8F3kZ9qLmP2xV7w'"                        => pass
    }
    py {
      "secret_token = 's3Cr3tV4lue9KqXz'" => fail
    }
  }
}
