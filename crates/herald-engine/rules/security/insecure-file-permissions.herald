rule insecure-file-permissions {
  meta {
    type: security
    severity: error
    message: "Permissions trop permissives — écriture ouverte aux « autres » (CWE-732) ; restreins à 0o600/0o644"
  }
  match {
    js, ts: $FS.chmodSync($P, $MODE)
    js, ts: $FS.chmod($P, $MODE)
    py:     os.chmod($P, $MODE)
  }
  when $MODE matches /0o?[0-7]{2}[2367]/

  tests {
    js {
      "fs.chmodSync('app.js', 0o777)" => fail
      "fs.chmodSync('secret.key', 0o666)" => fail
      "fs.chmod('data.json', 0o757)" => fail
      "fs.chmodSync('app.js', 0o644)" => pass
      "fs.chmodSync('secret.key', 0o600)" => pass
      "fs.chmodSync('bin', 0o755)" => pass
    }
    py {
      "os.chmod('script.sh', 0o766)" => fail
      "os.chmod('script.sh', 0o644)" => pass
    }
  }
}
