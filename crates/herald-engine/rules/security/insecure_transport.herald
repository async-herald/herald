rule insecure_transport {
  meta {
    type: security
    severity: warning
    message: "URL HTTP en clair — utilise https:// pour éviter l'écoute et le man-in-the-middle"
  }
  match: /(?i)\bhttp:\/\/[a-z0-9._-]+/
  when not @match ~ /(?i)http:\/\/(localhost|127\.\d{1,3}\.\d{1,3}\.\d{1,3}|0\.0\.0\.0|10\.\d{1,3}\.|192\.168\.|[a-z0-9.-]+\.(local|test|example)|([a-z0-9.-]+\.)?example\.(com|org|net)|[a-z0-9.-]*(w3|apache|springframework|xmlsoap|oasis-open)\.org|purl\.org|schemas?\.|xmlns)/
    and not @match ~ /(?i)xmlns/

  tests {
    js {
      "const u = 'http://api.acme.io/v1'" => fail
      "const u = 'https://api.acme.io/v1'" => pass
      "const u = 'http://localhost:3000'" => pass
      "const ns = 'http://www.w3.org/2000/svg'" => pass
      "const u = 'http://192.168.1.10/admin'" => pass
    }
  }
}
