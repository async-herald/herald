rule leaked-secret {
  meta {
    type: security
    severity: error
    message: "Jeton/secret en clair (clé API GitHub/AWS/Slack/Stripe, identifiants d'URL) — révoque-le et passe par un secret/variable d'environnement"
  }
  match {
    : /\b(ghp|gho|ghs|ghu|ghr)_[A-Za-z0-9]{20,}\b/
    : /\bAKIA[0-9A-Z]{16}\b/
    : /\bxox[baprs]-[A-Za-z0-9-]{10,}\b/
    : /\bsk_live_[A-Za-z0-9]{16,}\b/
    : /https?:\/\/[^\/\s:@]+:[^\/\s@]+@/
  }

  tests {
    js {
      "const t = 'ghp_PLACEHOLDERGITHUBTOKENVALUEXXXX'" => fail
      "const k = 'AKIAIOSFODNN7EXAMPLE'" => fail
      "const s = 'xoxb-PLACEHOLDER-SLACK-TOKEN'" => fail
      "const p = 'sk_live_ExampleStripeKeyAb'" => fail
      "const r = 'https://user:ghp_x@github.com/o/r.git'" => fail
      "const k = process.env.GH_TOKEN" => pass
      "const url = 'https://api.example.com/v2'" => pass
    }
  }
}
