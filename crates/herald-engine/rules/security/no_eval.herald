rule no_eval {
  meta {
    type: security
    severity: error
    message: "Évite eval()/exec() — exécute du code arbitraire, risque de sécurité majeur"
  }

  match {
    js, ts: eval($X)
    py:     eval($X)
    py:     exec($X)
    php:    eval($X)
  }

  tests {
    js {
      "eval(userInput)" => fail
      "eval('1 + 1')"   => fail
      "evaluate(expr)"  => pass
    }
    py {
      "eval(data)" => fail
      "exec(code)" => fail
    }
    php {
      "<?php eval($code);"        => fail
      "<?php $r = evaluate($x);"  => pass
    }
  }
}
