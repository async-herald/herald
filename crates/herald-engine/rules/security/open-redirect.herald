rule open-redirect {
  meta {
    type: security
    severity: error
    message: "Open redirect possible : la cible de la redirection provient d'une entrée utilisateur — valide-la contre une allowlist ou n'autorise que les chemins relatifs"
  }
  match {
    js, ts: $RES.redirect($URL)
    java: $RESP.sendRedirect($URL)
    php: header($URL)
    php: $CTRL->redirect($URL)
  }
  when $URL is user-input

  tests {
    js {
      "res.redirect(req.query.next)" => fail
      "res.redirect('/dashboard')" => pass
    }
    java {
      "resp.sendRedirect(request.getParameter('url'))" => fail
    }
    php {
      "<?php header('Location: ' . $_GET['next']);"     => fail
      "<?php return $this->redirect($request->get('u'));" => fail
      "<?php header('Location: /dashboard');"           => pass
    }
  }
}
