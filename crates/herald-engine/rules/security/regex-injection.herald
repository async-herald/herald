rule regex-injection {
  meta {
    type: security
    severity: warning
    message: "Regex compilée depuis une source non littérale — une entrée non fiable peut causer un ReDoS ou une injection regex ; valide l'entrée ou utilise un motif fixe (avec un timeout adapté / RE2)"
  }
  match {
    js, ts: new RegExp($P)
    py: re.compile($P)
  }
  when not $P is constant

  tests {
    js {
      "new RegExp(userInput)" => fail
      "new RegExp('^' + prefix + '$')" => fail
      "new RegExp('^[a-z]+$')" => pass
    }
    py {
      "re.compile(pattern)" => fail
      "re.compile('^[a-z]+$')" => pass
    }
  }
}
