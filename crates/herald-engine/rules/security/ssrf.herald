rule ssrf {
  meta {
    type: security
    severity: error
    message: "SSRF possible : requête sortante vers une URL construite à partir d'une entrée dynamique — valide contre une allowlist d'hôtes"
  }
  match {
    js, ts: fetch($URL)
    js, ts: axios($URL)
  }
  when $URL is user-input

  tests {
    js {
      "fetch(req.query.target)" => fail
      "axios(req.params.url)" => fail
      "fetch('https://api.example.com/health')" => pass
    }
  }
}
