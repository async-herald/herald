rule ssti {
  meta {
    type: security
    severity: error
    message: "Injection de template côté serveur possible : un template/une expression est construit à partir d'une entrée dynamique — ne rends jamais une entrée non fiable comme template ; utilise un template fixe avec des variables échappées"
  }
  match {
    js, ts: $ENV.renderString($T)
    py: render_template_string($T)
  }
  when not $T is constant

  tests {
    js {
      "env.renderString(userTemplate)" => fail
      "env.renderString('<h1>{{ title }}</h1>')" => pass
    }
    py {
      "render_template_string(request.args.get('tpl'))" => fail
      "render_template_string('<h1>Hello</h1>')" => pass
    }
  }
}
