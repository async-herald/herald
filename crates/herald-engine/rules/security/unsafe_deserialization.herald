rule unsafe_deserialization {
  meta {
    type: security
    severity: error
    message: "Désérialisation non sûre d'une donnée non fiable — peut exécuter du code arbitraire ; utilise un loader sûr (ex. yaml.safe_load, JSON) et évite la sérialisation native"
  }
  match {
    js, ts: unserialize($X)
    py: pickle.loads($X)
    py: yaml.load($X)
    php: unserialize($X)
  }

  tests {
    js {
      "unserialize(payload)" => fail
    }
    py {
      "pickle.loads(data)" => fail
      "yaml.load(stream)" => fail
      "yaml.safe_load(stream)" => pass
    }
    php {
      "<?php $o = unserialize($_COOKIE['session']);" => fail
      "<?php $o = json_decode($payload, true);"      => pass
    }
  }
}
