rule weak_crypto {
  meta {
    type: security
    severity: error
    message: "Crypto faible/obsolète (MD5, SHA-1, DES, RC4) — préfère SHA-256+/AES"
  }
  match {
    : /(?i)\b(md[245]|sha-?1|rc[24]|3des|tripledes|blowfish)\b/
  }

  tests {
    js {
      "crypto.createHash('md5')" => fail
      "// legacy md5 removed" => pass
      "const algo = 'aes-256-gcm'" => pass
    }
    py {
      "hashlib.sha1(data)" => fail
    }
  }
}
